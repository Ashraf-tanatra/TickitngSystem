{
  "ConnectionStrings": {
    "constr": "Server=localhost;Database=TicketSystemDatabase;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "TaskFlow.Api",
    "Audience": "TaskFlow.Frontend",
    "AccessTokenMinutes": 60
  },
  "Https": {
    "Enforce": false,
    "Port": 443
  },
  "FileStorage": {
    "RootPath": ""
  },
  "Resend": {
    "FromEmail": "noreply@example.com",
    "ApiKey": "SET_IN_USER_SECRETS_OR_SERVER_ENVIRONMENT"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://example.com"
    ]
  },
  "RateLimit": {
    "ApiRequestsPerMinute": 120,
    "AnonymousRequestsPerMinute": 30,
    "AuthRequestsPerMinute": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
